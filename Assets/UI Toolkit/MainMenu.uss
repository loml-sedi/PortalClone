#MainMenu {
    width: 100%;
    height: 100%;
}

#BackgroundImage {
    position: absolute;

    width: 100%;
    height: 100%;

    background-image: url("your-background-image");
    -unity-background-scale-mode: scale-and-crop;
}

#MenuContent {
    position: absolute;

    left: 8%;
    top: 35%;

    width: 400px;
}

#MenuContent Button {
    width: 400px;
    height: 55px;

    margin-bottom: 4px;

    padding-left: 25px;

    background-color: rgba(0, 0, 0, 0);

    border-width: 0;
    border-radius: 0;

    -unity-text-align: middle-left;
}

#MenuContent Button #ButtonText {
    color: white;

    font-size: 22px;
}

#MenuContent Button:hover {
    background-color: rgba(0, 0, 0, 0.35);

    border-left-width: 5px;
    border-left-color: rgb(60, 160, 255);
}

#MenuContent Button:hover #ButtonText {
    color: rgb(60, 160, 255);
}

#MenuContent Button:focus {
    background-color: rgba(0, 0, 0, 0.35);

    border-left-width: 5px;
    border-left-color: rgb(60, 160, 255);
}

#MenuContent Button:focus #ButtonText {
    color: rgb(60, 160, 255);
}