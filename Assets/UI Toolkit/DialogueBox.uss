:root {
}

#dialogueBox {
    position: absolute;

    left: 15%;
    right: 15%;
    bottom: 10%;

    padding: 15px;

    flex-direction: column;

    background-color: rgba(0, 0, 0, 0.65);

    border-radius: 5px;
}

.speaker-label {
    font-size: 20px;
    color: rgb(255, 170, 0);
    -unity-font-style: bold;
}

.dialogue-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-top: 5px;
}

.wheatley {
    color: rgb(100, 200, 255);
}

.glados {
    color: rgb(150, 255, 150);
}
