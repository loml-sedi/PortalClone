#PauseMenu {
    position: absolute;

    width: 100%;
    height: 100%;
}


#PauseOverlay {
    position: absolute;

    width: 100%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0.45);
}


#PausePanel {
    position: absolute;

    left: 50%;
    top: 50%;

    translate: -50% -50%;

    width: 500px;

    align-items: center;
}


#PauseTitle {
    font-size: 32px;

    color: white;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    margin-bottom: 35px;
}


#PauseButtons {
    width: 100%;

    align-items: center;
}


#PauseButtons Button {
    width: 420px;
    height: 58px;

    margin-bottom: 10px;

    padding-left: 20px;
    padding-right: 20px;

    background-color: rgb(225, 225, 225);

    border-width: 0;
    border-radius: 0;

    color: rgb(20, 20, 20);

    font-size: 18px;

    -unity-font-style: normal;

    -unity-text-align: middle-center;
}


#PauseButtons Button:hover {
    background-color: rgb(45, 45, 45);

    color: white;
}

#PauseButtons Button:focus {
    background-color: rgb(45, 45, 45);

    color: white;
}

#DoneButton {
    width: 180px;
    height: 45px;

    margin-top: 25px;

    color: rgb(20, 20, 20);

    border-width: 0;
    border-radius: 0;

    font-size: 16px;

    -unity-font-style: normal;

    -unity-text-align: middle-center;

    background-color: rgb(150, 150, 150);
}

#DoneButton:hover {
    color: white;

    background-color: rgb(70, 70, 70);
}

#DoneButton:focus {
    color: white;

    background-color: rgb(70, 70, 70);
}