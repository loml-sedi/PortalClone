#PauseMenu {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

#PausePanel {
    width: 45%;
    height: 60%;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 30px;
    padding-bottom: 30px;
    background-color: rgba(0, 0, 0, 0.255);
    align-items: center;
}

#PauseTitle {
    width: 100%;
    margin-bottom: 25px;
    color: rgb(20, 20, 20);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#PauseButtons {
    width: 100%;
    flex-grow: 1;
    align-items: stretch;
}

#PauseButtons Button {
    width: 100%;
    flex-grow: 1;
    margin-bottom: 8px;
    background-color: rgb(225, 225, 225);
    border-width: 1px;
    border-color: rgb(180, 180, 180);
    border-radius: 0;
    color: rgb(20, 20, 20);
    font-size: 18px;
    -unity-text-align: middle-center;
}

#PauseButtons Button:hover,
#PauseButtons Button:focus {
    background-color: rgb(45, 45, 45);
    color: white;
}

#DoneButton {
    width: 180px;
    height: 45px;
    flex-shrink: 0;
    margin-top: 20px;
    background-color: rgb(150, 150, 150);
    border-width: 0;
    border-radius: 0;
    color: rgb(20, 20, 20);
    font-size: 16px;
    -unity-text-align: middle-center;
}
