  lines:
  - speaker: 0
    text: Oh! There you are.
    displayTime: 1.8
  - speaker: 0
    text: I was beginning to think they'd forgotten about me.
    displayTime: 2.8
  - speaker: 0
    text: But no! Here I am.
    displayTime: 2
  - speaker: 0
    text: "\u201CAnd I've got another test for you."
    displayTime: 2.3
  - speaker: 0
    text: Don't worry, this one should be perfectly safe.
    displayTime: 2.8
  - speaker: 0
    text: "\u2026Probably."
    displayTime: 1.5
  - speaker: 0
    text: Right. Off you go!
    displayTime: 1.8
